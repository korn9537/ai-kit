#!/usr/bin/env sh
# The ai-kit clone's own pre-commit (not the projects' runner in githooks/). Enable: git config core.hooksPath .githooks
cd "$(git rev-parse --show-toplevel)" || exit 1
node scripts/check-docs.mjs --wrap --staged || { echo "To bypass: git commit --no-verify"; exit 1; }
# docs/handoffs.md: a change to a route, an agent or the workflow runs the contract and workflow tests
if git diff --cached --name-only | grep -qE '^(agents/|workflows/|commands/|hooks/|docs/(handoffs|plan-batching|owner-kinds)\.md|CLAUDE\.core\.md|scripts/(plan|continuous|handoffs|run-plan))'; then
  for t in scripts/handoffs.test.mjs scripts/run-plan.test.mjs; do
    out=$(node "$t" 2>&1) || { printf '%s\n' "$out" | grep -v '^ok'; echo "To bypass: git commit --no-verify"; exit 1; }
  done
fi
