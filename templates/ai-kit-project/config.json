{
  "code_dirs": ["src", "scripts", ".claude", ".githooks", "ai/kit"],
  "comments": {
    "include": "^src/.*\\.(tsx?|jsx?|mjs|cs)$",
    "skip": "(/generated/|/node_modules/|\\.d\\.ts$|\\.Designer\\.cs$)"
  },
  "docs": {
    "include": "^ai/.*\\.md$",
    "skip": "(^|/)README\\.md$|/(mockups|design)/"
  },
  "build_guard": {
    "port": 3000,
    "hint": "A build writes where the dev server serves from. Run the typecheck instead."
  },
  "handoff": { "max_context": 150000 },
  "conventions": []
}
