#!/usr/bin/env sh
# ai-kit pre-commit runner: universal checks, then the project's ai/kit/pre-commit.sh, then the kit's own checks.
# Keep fast: only run a check when the files it guards are actually staged.
#
# This hook calls `node` directly and never `pnpm`: Git GUIs (GitHub Desktop, SourceTree) run hooks in their own
# MSYS shell, where the npm `pnpm` shim mis-resolves its directory and every GUI commit fails.

# the plugin root, from this file's own path (the shim in .githooks/ execs it)
ai_kit_plugin="$(cd "$(dirname "$0")/.." && pwd)"
cd "$(git rev-parse --show-toplevel)" || exit 1

# Print a check's output only when it fails; on success, collapse its `!` warnings into one line.
quiet() {
  out=$("$@" 2>&1); rc=$?
  if [ $rc -ne 0 ]; then printf '%s\n' "$out"
  else
    n=$(printf '%s\n' "$out" | grep -c '^!')
    [ "$n" -gt 0 ] && echo "warn: $n warning(s) from: $* (run it alone for details)"
  fi
  return $rc
}

if ! command -v node >/dev/null 2>&1; then
  echo "commit blocked: 'node' is not on PATH for this git client."
  echo "   Install Node (>= 22) or launch your git client from a shell that has it."
  echo "   To bypass: git commit --no-verify"
  exit 1
fi

# A backslash is a valid filename char on macOS/Linux, so a Windows-style output path (`-o bin\Debug`) creates a
# malformed dir that .gitignore misses.
if git -c core.quotePath=false diff --cached --name-only --diff-filter=ACMR | grep -q '\\'; then
  echo "commit blocked: staged path contains a backslash (\\) — likely a malformed build dir."
  git -c core.quotePath=false diff --cached --name-only --diff-filter=ACMR | grep '\\' | sed 's/^/   /'
  echo "Delete it (e.g. rm -rf the offending dir) and re-stage. To bypass: git commit --no-verify"
  exit 1
fi

# Docs are for AI readers (the plugin's docs/ai-docs.md): added lines only, so it runs before prettier reflows
# them; scope is docs.include in ai/kit/config.json.
if [ -n "$(git diff --cached --name-only --diff-filter=ACMR)" ]; then
  node "$ai_kit_plugin/scripts/check-docs.mjs" --staged --strict || {
    echo ""
    echo "Docs rule failed. Drop emoji, bold, filler and dates; quote Thai product copy; point at a symbol, not a line. To bypass: git commit --no-verify"
    exit 1
  }
fi

# A lint suppression names why the rule does not apply; "moved verbatim" is no reason (CLAUDE.core.md, 40 KB split).
moved="$(git -c core.quotePath=false diff --cached -U0 --diff-filter=ACMR -- . ':(exclude)*.md' \
  | grep -E '^\+' | grep -vE '^\+\+\+ ' | grep -iE 'eslint-disable[^*]*--[[:space:]]*moved verbatim')"
if [ -n "$moved" ]; then
  echo "commit blocked: an eslint-disable gives \"moved verbatim\" as its reason:"
  printf '%s\n' "$moved" | sed 's/^+/   /'
  echo "Fix the moved code, or name why the rule does not apply. To bypass: git commit --no-verify"
  exit 1
fi

# Prettier on staged files when package.json declares it. A fully staged file is formatted and re-staged; a partially
# staged one (other hunks left in the work tree, maybe another session's) gets only its index blob formatted.
if grep -q '"prettier"' package.json 2>/dev/null && [ -n "$(git diff --cached --name-only --diff-filter=ACMR)" ]; then
  prettier=node_modules/prettier/bin/prettier.cjs
  if [ ! -f "$prettier" ]; then
    echo "commit blocked: node_modules/prettier is missing — install packages first."
    echo "   To bypass: git commit --no-verify"
    exit 1
  fi
  unstaged="$(git -c core.quotePath=false diff --name-only)"
  # paths are literal below: a Next.js route `app/[id]/page.tsx` is a glob to git
  whole="" partial=""
  while IFS= read -r f; do
    if printf '%s\n' "$unstaged" | grep -qxF -- "$f"; then partial="$partial$f
"; else whole="$whole$f
"; fi
  done <<EOF
$(git -c core.quotePath=false diff --cached --name-only --diff-filter=ACMR)
EOF
  if [ -n "$whole" ]; then
    printf '%s' "$whole" | tr '\n' '\0' \
      | xargs -0 node "$prettier" --write --ignore-unknown --log-level warn || {
      echo "prettier failed — fix the error above, or to bypass: git commit --no-verify"
      exit 1
    }
    printf '%s' "$whole" | tr '\n' '\0' | xargs -0 git --literal-pathspecs add --
  fi
  if [ -n "$partial" ]; then
    tmp="$(mktemp)"
    while IFS= read -r f; do
      [ -n "$f" ] || continue
      # stdin with --ignore-unknown prints nothing for an unknown type: skip those before piping the blob
      node "$prettier" --file-info "$f" | grep -q '"ignored": false, "inferredParser": "' || continue
      git show ":$f" | node "$prettier" --stdin-filepath "$f" --log-level warn >"$tmp" || {
        rm -f "$tmp"
        echo "prettier failed on the staged $f — fix the error above, or to bypass: git commit --no-verify"
        exit 1
      }
      blob="$(git hash-object -w --path="$f" "$tmp")"
      [ "$blob" = "$(git rev-parse ":$f")" ] && continue
      git update-index --cacheinfo "$(git --literal-pathspecs ls-files -s -- "$f" | cut -d' ' -f1),$blob,$f"
      echo "warn: $f is partially staged: formatted its staged version only, the work tree is unchanged"
    done <<EOF
$partial
EOF
    rm -f "$tmp"
  fi
fi

# shellcheck source=/dev/null
[ -f ai/kit/pre-commit.sh ] && . ai/kit/pre-commit.sh

# Comments are for AI only (the plugin's docs/code-comments.md); scope is comments.include in ai/kit/config.json.
if [ -n "$(git diff --cached --name-only --diff-filter=ACMR)" ]; then
  node "$ai_kit_plugin/scripts/check-comments.mjs" --staged --strict || {
    echo ""
    echo "Comment rule failed. Shorten to 1-2 lines, move the rule to a doc, or drop the date / who asked. To bypass: git commit --no-verify"
    exit 1
  }
fi

# Screen specs stay linked to the API and the screen files (the plugin's docs/screen-specs.md); warnings only.
# Starts node only when ui.platforms looks non-empty; the script itself waits for a guarded staged file.
if tr -d '[:space:]' < ai/kit/config.json 2>/dev/null | grep -q '"platforms":\["'; then
  quiet node "$ai_kit_plugin/scripts/check-specs.mjs" --staged
fi

# The project's kit wiring (config, shim, plugin settings, no 1.x leftovers) is still sound.
if git -c core.quotePath=false diff --cached --name-only --diff-filter=ACMRD | grep -qE '^(ai/kit/config\.json|\.githooks/|\.claude/settings\.json$|\.claude/agents/|CLAUDE\.md$)'; then
  node "$ai_kit_plugin/scripts/kit.mjs" check || {
    echo ""
    echo "ai-kit check failed: apply the fix each line names. To bypass: git commit --no-verify"
    exit 1
  }
fi
