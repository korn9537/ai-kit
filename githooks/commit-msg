#!/usr/bin/env sh
# commit-msg runner, called by the project's .githooks/commit-msg shim: every commit names the job (one user request)
# it belongs to, so scripts/jobs.mjs finds all of its commits to revert. Rule: docs/shared-checkout.md §Jobs.
msg="$1"
[ -f "$(git rev-parse --git-path MERGE_HEAD)" ] && exit 0
head -n 1 "$msg" | grep -qE '^(fixup|squash|amend)! ' && exit 0

jobs=$(git interpret-trailers --parse "$msg" | grep -E '^Job: ' | sed 's/^Job: //')
n=$(printf '%s' "$jobs" | grep -c .)
if [ "$n" -ne 1 ] || ! printf '%s\n' "$jobs" | grep -qE '^[0-9]{4}-[0-9]{2}-[0-9]{2}-[a-z0-9]+(-[a-z0-9]+)*$'; then
  echo "commit-msg: the message needs exactly one trailer 'Job: <yyyy-mm-dd>-<slug>' (e.g. Job: 2026-01-05-invoice-export)."
  echo "Every commit of one request shares it; a fix commit copies the job of the commit it fixes (ai-kit docs/shared-checkout.md §Jobs)."
  exit 1
fi
exit 0
