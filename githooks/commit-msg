#!/usr/bin/env sh
# commit-msg runner, called by the project's .githooks/commit-msg shim: every commit Claude Code makes names the job (one
# user request) it belongs to, so scripts/jobs.mjs finds all of its commits to revert. Rule: docs/shared-checkout.md §Jobs.
msg="$1"
# a person committing by hand (VS Code, a terminal) is not held to it: Claude Code sets CLAUDECODE=1 in the shells it
# runs, sessions and subagents alike, so the rule binds the agent's commits only
[ "${CLAUDECODE:-}" = 1 ] || exit 0
[ -f "$(git rev-parse --git-path MERGE_HEAD)" ] && exit 0
head -n 1 "$msg" | grep -qE '^(fixup|squash|amend)! ' && exit 0

# any body paragraph made only of `Key: value` lines, as scripts/jobs.mjs reads %b (the subject paragraph is not
# body): a blank line between Job and Co-Authored-By hid Job from `git interpret-trailers` (most committer retries);
# a Job line in prose still is none. The scissors line of `git commit -v` and the diff below it are cut first
jobs=$(sed '/^. -\{24\} >8 -\{24\}$/,$d' "$msg" | git stripspace --strip-comments | tr -d '\r' | awk 'BEGIN { RS = "" } NR > 1 {
  n = split($0, l, "\n"); ok = 1
  for (i = 1; i <= n; i++) if (l[i] !~ /^[A-Za-z][-A-Za-z0-9_]*: [^ \t]/) ok = 0
  if (ok) for (i = 1; i <= n; i++) if (l[i] ~ /^Job: /) { v = substr(l[i], 6); sub(/[ \t]+$/, "", v); print v }
}')
n=$(printf '%s' "$jobs" | grep -c .)
if [ "$n" -ne 1 ] || ! printf '%s\n' "$jobs" | grep -qE '^[0-9]{4}-[0-9]{2}-[0-9]{2}-[a-z0-9]+(-[a-z0-9]+)*$'; then
  echo "commit-msg: the message needs exactly one trailer 'Job: <yyyy-mm-dd>-<slug>' (e.g. Job: 2026-01-05-invoice-export)."
  echo "Every commit of one request shares it; a fix commit copies the job of the commit it fixes (ai-kit docs/shared-checkout.md §Jobs)."
  # best effort: a record of the refusal for scripts/usage.mjs digest; node may be missing
  node "$(cd "$(dirname "$0")/.." && pwd)/scripts/usage.mjs" refusal commit-msg.job >/dev/null 2>&1 || true
  exit 1
fi

# a job with a plan commits only paths the plan covers (plan.mjs scope): in a shared index, a path outside it may be
# another session's staged work. *.md is exempt (a committer fixes any doc naming what it changed); amends included
[ "${ALLOW_OUTSIDE_PLAN:-}" = 1 ] && exit 0
[ -f "ai/plans/$jobs.md" ] && command -v node >/dev/null 2>&1 || exit 0
plugin="$(cd "$(dirname "$0")/.." && pwd)"
stray=$(git -c core.quotePath=false diff --cached --name-only --no-renames | grep -v '\.md$' |
  node "$plugin/scripts/plan.mjs" scope "$jobs" --outside 2>/dev/null) || exit 0
if [ -n "$stray" ]; then
  echo "commit-msg: staged paths outside the plan of job $jobs (ai/plans/$jobs.md), maybe another session's work:"
  printf '%s\n' "$stray" | sed 's/^/   /'
  echo "Unstage each that is not yours: git restore --staged <path>. Yours (a lockfile, generated output): ALLOW_OUTSIDE_PLAN=1 git commit ..."
  node "$plugin/scripts/usage.mjs" refusal commit-msg.plan >/dev/null 2>&1 || true
  exit 1
fi
exit 0
